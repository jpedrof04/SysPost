<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] — SysPost</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <!-- ══════════════════ NAVBAR ══════════════════ -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom border-secondary-subtle">
        <div class="container">

            <!-- LOGO -->
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">

                <i class="bi bi-layers-half me-1"></i>
                SysPost
            </a>

            <!-- MOBILE -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="navMenu">

                <!-- ESQUERDA -->
                <ul class="navbar-nav me-auto align-items-lg-center">

                    <!-- HOME -->
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">

                            <i class="bi bi-house me-1"></i>
                            Início
                        </a>
                    </li>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- NOVO POST -->
                        <li class="nav-item">
                            <a class="nav-link text-success fw-bold" asp-controller="Post" asp-action="Create">

                                <i class="bi bi-plus-circle me-1"></i>
                                Criar Post
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Post" asp-action="MeusPosts">

                                <i class="bi bi-file-earmark-post me-1"></i>
                                Meus Posts
                            </a>
                        </li>

                        <!-- ÁREA USUÁRIO -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Usuario" asp-action="Index">

                                <i class="bi bi-person-circle me-1"></i>
                                Minha Área
                            </a>
                        </li>

                        <!-- ADMIN -->
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-controller="Admin" asp-action="Index">

                                    <i class="bi bi-shield-lock me-1"></i>
                                    Administração
                                </a>
                            </li>
                        }
                    }

                </ul>

                <!-- DIREITA -->
                <ul class="navbar-nav ms-auto">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">

                                <i class="bi bi-person me-1"></i>
                                @User.Identity.Name
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end">

                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="Perfil">

                                        <i class="bi bi-person-gear me-2"></i>
                                        Meu Perfil
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" asp-controller="Post" asp-action="Create">

                                        <i class="bi bi-pencil-square me-2"></i>
                                        Criar Post
                                    </a>
                                </li>

                                @if (User.IsInRole("Admin"))
                                {
                                    <li>
                                        <a class="dropdown-item text-warning" asp-controller="Admin" asp-action="Index">

                                            <i class="bi bi-speedometer2 me-2"></i>
                                            Painel Admin
                                        </a>
                                    </li>
                                }

                                <li>
                                    <hr class="dropdown-divider" />
                                </li>

                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit" class="dropdown-item text-danger">

                                            <i class="bi bi-box-arrow-right me-2"></i>
                                            Sair
                                        </button>

                                    </form>
                                </li>

                            </ul>

                        </li>
                    }
                    else
                    {
                        <!-- LOGIN -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">

                                <i class="bi bi-box-arrow-in-right me-1"></i>
                                Entrar
                            </a>
                        </li>

                        <!-- REGISTER -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Register">

                                <i class="bi bi-person-plus me-1"></i>
                                Registrar
                            </a>
                        </li>
                    }

                </ul>

            </div>

        </div>
    </nav>

    <!-- ══════════════════ MAIN ══════════════════ -->
    <main class="container my-4">

        <!-- SUCESSO -->
        @if (TempData["Sucesso"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">

                <i class="bi bi-check-circle me-2"></i>
                @TempData["Sucesso"]

                <button type="button" class="btn-close" data-bs-dismiss="alert">
                </button>

            </div>
        }

        <!-- ERRO -->
        @if (TempData["Erro"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">

                <i class="bi bi-exclamation-triangle me-2"></i>
                @TempData["Erro"]

                <button type="button" class="btn-close" data-bs-dismiss="alert">
                </button>

            </div>
        }

        <!-- AVISO -->
        @if (TempData["Aviso"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">

                <i class="bi bi-info-circle me-2"></i>
                @TempData["Aviso"]

                <button type="button" class="btn-close" data-bs-dismiss="alert">
                </button>

            </div>
        }

        <!-- BODY -->
        @RenderBody()

    </main>

    <!-- ══════════════════ FOOTER ══════════════════ -->
    <footer class="bg-dark border-top border-secondary-subtle text-white text-center py-4 mt-5">

        <div class="container">

            <small class="text-muted">
                &copy; @DateTime.Now.Year — SysPost · Projeto de Estudo ASP.NET Core MVC
            </small>

        </div>

    </footer>

    <!-- Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>