@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size:4rem;"></i>
    <h1 class="text-danger fw-bold mt-3">Error</h1>
    <h2 class="text-muted">An error occurred while processing your request.</h2>

    @if (Model.ShowRequestId)
    {
        <p class="mt-3">
            <strong>Request ID:</strong> <code class="text-primary">@Model.RequestId</code>
        </p>
    }

    <hr class="my-4" style="max-width:300px;margin:auto;">

    <p class="text-muted small">
        Please try again or contact support.
    </p>
</div>
