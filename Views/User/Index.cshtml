@model SysPost.Models.Usuario
@{
    ViewData["Title"] = "Minha Área";
}

<div class="container py-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <i class="bi bi-person-circle fs-1 text-primary"></i>
        <h2 class="fw-bold mb-0">Minha Área</h2>
    </div>

    <div class="card p-4 text-center">
        @if (Model.FotoPerfil != null && Model.FotoPerfil.Length > 0)
        {
            var base64 = Convert.ToBase64String(Model.FotoPerfil);
            <img src="data:image;base64,@base64" alt="Foto"
                 class="rounded-circle mx-auto d-block mb-3"
                 style="width:100px;height:100px;object-fit:cover;" />
        }
        else
        {
            <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center mx-auto mb-3"
                 style="width:100px;height:100px;">
                <i class="bi bi-person-fill text-white fs-1"></i>
            </div>
        }

        <h4 class="fw-bold mb-1">@Model.NomeCompleto</h4>
        <p class="text-muted mb-3">@Model.Email</p>

        @if (!string.IsNullOrEmpty(Model.Bio))
        {
            <p class="text-muted">@Model.Bio</p>
        }

        <div class="d-flex justify-content-center gap-2 mt-2">
            <a asp-controller="Account" asp-action="Perfil" class="btn btn-primary">
                <i class="bi bi-person-gear me-1"></i>Meu Perfil
            </a>
            <a asp-controller="Account" asp-action="EditarPerfil" class="btn btn-outline-primary">
                <i class="bi bi-pencil me-1"></i>Editar
            </a>
        </div>
    </div>
</div>
