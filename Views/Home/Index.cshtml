@using SysPost.Models

@{
    var posts = ViewBag.Posts as List<Post>;
    var filtroNome = ViewBag.FiltroUsuarioNome as string;
    var filtroTopico = ViewBag.FiltroTopico as TopicoPost?;
}

<div class="mt-4"></div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">
        <i class="bi bi-fire me-2 text-primary"></i>
        Feed de Posts
    </h3>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Post" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Criar Post
        </a>
    }
</div>

<div class="card p-3 mb-4">
    <form method="get" action="/" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label small text-muted mb-1">
                <i class="bi bi-person me-1"></i>Usuário
            </label>
            <input type="text" name="usuarioNome" class="form-control"
                   placeholder="Filtrar por nome do usuário..." value="@filtroNome" />
        </div>
        <div class="col-md-5">
            <label class="form-label small text-muted mb-1">
                <i class="bi bi-tag me-1"></i>Tópico
            </label>
            <select name="topico" class="form-select">
                <option value="">Todos os tópicos</option>
                @foreach (var t in Enum.GetValues<TopicoPost>())
                {
                    var selected = filtroTopico.HasValue && filtroTopico.Value == t;
                    <option value="@((int)t)" selected="@selected">@t</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-search me-1"></i>Filtrar
            </button>
            @if (!string.IsNullOrEmpty(filtroNome) || filtroTopico.HasValue)
            {
                <a href="/" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </div>
    </form>
</div>

<div class="row g-4">

    @if (posts != null && posts.Any())
    {
        @foreach (var post in posts)
        {
            <div class="col-md-6 col-lg-4">

                <div class="card h-100 shadow-sm border-0">

                    @if (post.Imagem != null)
                    {
                        var base64 = Convert.ToBase64String(post.Imagem);

                        <img src="data:image/png;base64,@base64"
                             class="card-img-top"
                             style="height:220px;object-fit:cover;" />
                    }

                    <div class="card-body">

                        <span class="badge bg-success mb-2">
                            @post.Topico
                        </span>

                        <h5 class="fw-bold">
                            @post.Titulo
                        </h5>

                        <p class="text-muted">
                            @post.Descricao
                        </p>

                    </div>

                    <div class="card-footer bg-transparent border-0">

                        <small class="text-muted d-block">
                            <i class="bi bi-person me-1"></i>
                            @post.Usuario.NomeCompleto
                        </small>

                        <small class="text-muted">
                            <i class="bi bi-clock me-1"></i>
                            @post.DataCriacao.ToString("dd/MM/yyyy HH:mm")
                        </small>

                    </div>

                </div>

            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-secondary">
                Nenhum post encontrado.
            </div>
        </div>
    }

</div>