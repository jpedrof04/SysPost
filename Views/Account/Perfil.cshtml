@model SysPost.ViewModels.PerfilViewModel
@{
    ViewData["Title"] = "Meu Perfil";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="card">
            <div class="profile-header">
                @if (Model.FotoPerfil != null && Model.FotoPerfil.Length > 0)
                {
                    var base64 = Convert.ToBase64String(Model.FotoPerfil);
                    <img src="data:image;base64,@base64" class="profile-avatar" alt="Foto" />
                }
                else
                {
                    <div class="profile-avatar-placeholder">
                        <i class="bi bi-person-fill text-muted" style="font-size:2.5rem;"></i>
                    </div>
                }

                <h4 class="fw-bold mb-1">@Model.NomeCompleto</h4>
                <p class="text-muted small mb-1"><i class="bi bi-envelope-fill me-1"></i>@Model.Email</p>
                <span class="badge bg-primary mb-3">@Model.Perfil</span>

                @if (!string.IsNullOrEmpty(Model.Bio))
                {
                    <p class="text-muted small">@Model.Bio</p>
                }

                <p class="text-dim small">
                    <i class="bi bi-calendar me-1"></i>
                    Membro desde @Model.DataCadastro.ToString("dd/MM/yyyy")
                </p>

                <a asp-action="EditarPerfil" class="btn btn-outline-primary btn-sm mt-2">
                    <i class="bi bi-pencil me-1"></i>Editar Perfil
                </a>
            </div>
        </div>
    </div>
</div>
