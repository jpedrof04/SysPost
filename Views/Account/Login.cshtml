@model SysPost.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Entrar";
    string? returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-4 auth-card">
        <div class="card">
            <div class="card-body">
                <div class="text-center mb-4">
                    <i class="bi bi-twitch text-primary" style="font-size:2.5rem;"></i>
                    <h4 class="fw-bold mt-2">Bem-vindo de volta</h4>
                    <p class="text-muted small">Entre na sua conta SysPost</p>
                </div>

                <form asp-controller="Account" asp-action="Login" method="post" asp-route-returnUrl="@returnUrl">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope-fill"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="seu@email.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Senha" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                            <input asp-for="Senha" class="form-control" placeholder="Sua senha" type="password" />
                        </div>
                        <span asp-validation-for="Senha" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="LembrarMe" class="form-check-input" />
                        <label asp-for="LembrarMe" class="form-check-label small">Manter conectado</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-3">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Entrar
                    </button>

                    <div class="text-center">
                        <a asp-controller="Account" asp-action="Register" class="small">
                            <i class="bi bi-person-plus me-1"></i>Não tem conta? Cadastre-se
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
