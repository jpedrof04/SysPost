@model SysPost.ViewModels.EditarPerfilViewModel
@{
    ViewData["Title"] = "Editar Perfil";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6 auth-card">
        <div class="card">
            <div class="card-body">
                <div class="text-center mb-4">
                    <i class="bi bi-pencil text-primary" style="font-size:2rem;"></i>
                    <h4 class="fw-bold mt-2">Editar Perfil</h4>
                </div>

                @if (Model.FotoAtual != null && Model.FotoAtual.Length > 0)
                {
                    var base64 = Convert.ToBase64String(Model.FotoAtual);
                    <div class="text-center mb-4">
                        <img src="data:image;base64,@base64"
                             id="preview"
                             class="profile-avatar" />
                    </div>
                }
                else
                {
                    <div class="text-center mb-4">
                        <div class="profile-avatar-placeholder" id="preview-placeholder">
                            <i class="bi bi-person-fill text-muted" style="font-size:2.5rem;"></i>
                        </div>
                    </div>
                }

                <form asp-action="EditarPerfil" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="NomeCompleto" class="form-label"></label>
                        <input asp-for="NomeCompleto" class="form-control" />
                        <span asp-validation-for="NomeCompleto" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Bio" class="form-label"></label>
                        <textarea asp-for="Bio" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Bio" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FotoArquivo" class="form-label"></label>
                        <input asp-for="FotoArquivo" class="form-control" type="file"
                               accept="image/*" onchange="previewFoto(this)" />
                        <span asp-validation-for="FotoArquivo" class="text-danger small"></span>
                        <div class="form-text">Máximo 2MB. Formatos: JPG, PNG, GIF, WEBP.</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Salvar
                        </button>
                        <a asp-action="Perfil" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewFoto(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    let img = document.getElementById('preview');
                    const placeholder = document.getElementById('preview-placeholder');
                    if (!img) {
                        img = document.createElement('img');
                        img.id = 'preview';
                        img.className = 'profile-avatar';
                        if (placeholder) placeholder.replaceWith(img);
                    }
                    img.src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
