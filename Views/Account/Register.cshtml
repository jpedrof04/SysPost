@model SysPost.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Criar Conta";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5 auth-card">
        <div class="card">
            <div class="card-body">
                <div class="text-center mb-4">
                    <i class="bi bi-pen-fill text-primary" style="font-size:2.5rem;"></i>
                    <h4 class="fw-bold mt-2">Criar Conta</h4>
                    <p class="text-muted small">Junte-se à comunidade SysPost</p>
                </div>

                <form asp-controller="Account" asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="NomeCompleto" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person-fill"></i></span>
                            <input asp-for="NomeCompleto" class="form-control" placeholder="Seu nome completo" />
                        </div>
                        <span asp-validation-for="NomeCompleto" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope-fill"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="seu@email.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Senha" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                            <input asp-for="Senha" class="form-control" placeholder="Mínimo 6 caracteres" type="password" />
                        </div>
                        <span asp-validation-for="Senha" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmarSenha" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                            <input asp-for="ConfirmarSenha" class="form-control" placeholder="Repita a senha" type="password" />
                        </div>
                        <span asp-validation-for="ConfirmarSenha" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-success w-100 mb-3">
                        <i class="bi bi-person-check me-2"></i>Criar Conta
                    </button>

                    <div class="text-center">
                        <a asp-action="Login" class="small">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Já tem conta? Entrar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
