@model List<SysPost.Models.Post>
@{
    ViewData["Title"] = "Meus Posts";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <i class="bi bi-file-earmark-post text-primary" style="font-size:1.6rem;"></i>
    <h4 class="fw-bold mb-0">Meus Posts</h4>
    <span class="badge bg-primary">@Model.Count posts</span>
    <a asp-action="Create" class="btn btn-primary btn-sm ms-auto">
        <i class="bi bi-plus-circle me-1"></i>Novo Post
    </a>
</div>

@if (Model.Any())
{
    @foreach (var post in Model)
    {
        <div class="reddit-card">
            <div class="vote-col">
                <button class="vote-btn like" title="Like" onclick="event.preventDefault()">
                    <i class="bi bi-hand-thumbs-up" style="font-size:1rem;"></i>
                </button>
                <span class="vote-count">@post.Comentarios.Count</span>
                <button class="vote-btn dislike" title="Dislike" onclick="event.preventDefault()">
                    <i class="bi bi-hand-thumbs-down" style="font-size:1rem;"></i>
                </button>
            </div>
            <div class="content-col">
                <div class="post-meta">
                    <span><i class="bi bi-person-fill me-1"></i>Você</span>
                    <span class="mx-1">·</span>
                    <span>@post.DataCriacao.ToString("dd MMM yyyy")</span>
                    <span class="mx-1">·</span>
                    <span class="badge bg-success">@post.Topico</span>
                </div>

                <a asp-action="Detalhes" asp-route-id="@post.Id" class="post-title">
                    @post.Titulo
                </a>

                <div class="post-desc">@post.Descricao</div>

                <div class="post-footer">
                    <a asp-action="Detalhes" asp-route-id="@post.Id" class="footer-btn">
                        <i class="bi bi-chat-dots me-1"></i>
                        @post.Comentarios.Count comentários
                    </a>

                    <a asp-action="Edit" asp-route-id="@post.Id" class="footer-btn">
                        <i class="bi bi-pencil me-1"></i>Editar
                    </a>

                    <form asp-action="Delete" asp-route-id="@post.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Tem certeza?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="footer-btn text-danger">
                            <i class="bi bi-trash me-1"></i>Excluir
                        </button>
                    </form>

                    @if (post.Imagem != null)
                    {
                        var base64 = Convert.ToBase64String(post.Imagem);
                        <img src="data:image/png;base64,@base64" class="post-thumb ms-auto" />
                    }
                    else
                    {
                        <div class="thumb-placeholder ms-auto">
                            <i class="bi bi-file-text"></i>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-inbox text-dim" style="font-size:3rem;"></i>
        <p class="text-muted mt-3">Você ainda não criou nenhum post.</p>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle me-1"></i>Criar primeiro post
        </a>
    </div>
}
