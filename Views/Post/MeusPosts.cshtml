@model List<SysPost.Models.Post>
@{
    ViewData["Title"] = "Meus Posts";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <i class="bi bi-file-earmark-post text-primary" style="font-size:1.6rem;"></i>
    <h4 class="fw-bold mb-0">Meus Posts</h4>
    <span class="badge bg-primary">@Model.Count posts</span>
    <a asp-action="Create" class="btn btn-primary btn-sm ms-auto">
        <i class="bi bi-plus-circle me-1"></i>Novo Post
    </a>
</div>

@if (Model.Any())
{
    <div class="posts-grid">
        @foreach (var post in Model)
        {
            <div class="post-card">
                <div class="post-card-header">
                    <div class="post-author">
                        <div class="author-avatar">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <div class="author-info">
                            <span class="author-name">Você</span>
                            <span class="post-date">@post.DataCriacao.ToString("dd MMM yyyy")</span>
                        </div>
                    </div>
                    <span class="badge bg-success">@post.Topico</span>
                </div>

                <div class="post-card-body">
                    <a asp-action="Detalhes" asp-route-id="@post.Id" class="post-card-title">
                        @post.Titulo
                    </a>
                    <p class="post-card-desc">@post.Descricao</p>
                </div>

                @if (post.Imagem != null)
                {
                    var base64 = Convert.ToBase64String(post.Imagem);
                    <div class="post-card-img">
                        <img src="data:image/png;base64,@base64" />
                    </div>
                }

                <div class="post-card-footer">
                    <a asp-action="Detalhes" asp-route-id="@post.Id" class="post-action">
                        <i class="bi bi-chat-dots"></i>
                        <span>@post.Comentarios.Count</span>
                    </a>

                    <a asp-action="Edit" asp-route-id="@post.Id" class="post-action">
                        <i class="bi bi-pencil"></i>
                        <span>Editar</span>
                    </a>

                    <form asp-action="Delete" asp-route-id="@post.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Tem certeza?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="post-action text-danger">
                            <i class="bi bi-trash"></i>
                            <span>Excluir</span>
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-inbox text-dim" style="font-size:3rem;"></i>
        <p class="text-muted mt-3">Você ainda não criou nenhum post.</p>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle me-1"></i>Criar primeiro post
        </a>
    </div>
}
