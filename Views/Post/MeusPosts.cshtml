@model List<SysPost.Models.Post>
@{
    ViewData["Title"] = "Meus Posts";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">
        <i class="bi bi-file-earmark-post me-2 text-primary"></i>
        Meus Posts
    </h3>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Novo Post
    </a>
</div>

@if (Model.Any())
{
    <div class="row g-4">
        @foreach (var post in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0">

                    @if (post.Imagem != null)
                    {
                        var base64 = Convert.ToBase64String(post.Imagem);
                        <img src="data:image/png;base64,@base64"
                             class="card-img-top"
                             style="height:200px;object-fit:cover;" />
                    }

                    <div class="card-body">
                        <span class="badge bg-success mb-2">@post.Topico</span>
                        <h5 class="fw-bold">@post.Titulo</h5>
                        <p class="text-muted">@post.Descricao</p>
                        <small class="text-muted">
                            <i class="bi bi-clock me-1"></i>
                            @post.DataCriacao.ToString("dd/MM/yyyy HH:mm")
                        </small>
                    </div>

                    <div class="card-footer bg-transparent border-0 d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@post.Id" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-pencil me-1"></i>Editar
                        </a>
                        <form asp-action="Delete" asp-route-id="@post.Id" method="post"
                              onsubmit="return confirm('Tem certeza que deseja excluir este post?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash me-1"></i>Excluir
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-secondary">
        <i class="bi bi-info-circle me-2"></i>
        Você ainda não criou nenhum post.
        <a asp-action="Create" class="alert-link">Criar primeiro post</a>
    </div>
}
