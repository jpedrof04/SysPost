@model SysPost.ViewModels.CriarPostViewModel

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <i class="bi bi-pencil-square text-primary" style="font-size:1.8rem;"></i>
                    <h4 class="fw-bold mb-0">Criar Post</h4>
                </div>

                <form method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Titulo" class="form-label"></label>
                        <input asp-for="Titulo" class="form-control" placeholder="Título do post" />
                        <span asp-validation-for="Titulo" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descricao" class="form-label"></label>
                        <textarea asp-for="Descricao" class="form-control" rows="3" placeholder="Descrição curta"></textarea>
                        <span asp-validation-for="Descricao" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Detalhamento" class="form-label"></label>
                        <textarea asp-for="Detalhamento" class="form-control" rows="6"
                                  placeholder="Informações detalhadas sobre o post..."></textarea>
                        <span asp-validation-for="Detalhamento" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="InformacaoEspecial" class="form-label"></label>
                        <textarea asp-for="InformacaoEspecial" class="form-control" rows="4"
                                  placeholder="Códigos ou informações especiais..."></textarea>
                        <span asp-validation-for="InformacaoEspecial" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Topico" class="form-label"></label>
                            <select asp-for="Topico" class="form-select"
                                    asp-items="Html.GetEnumSelectList<SysPost.Models.TopicoPost>()">
                                <option value="">Selecione um tópico</option>
                            </select>
                            <span asp-validation-for="Topico" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Imagem" class="form-label"></label>
                            <input asp-for="Imagem" type="file" class="form-control" accept="image/*" />
                            <span asp-validation-for="Imagem" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-send me-1"></i>Publicar
                        </button>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
