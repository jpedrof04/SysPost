@model SysPost.ViewModels.PostDetalhesViewModel
@{
    ViewData["Title"] = Model.Post.Titulo;
}

<a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">
    <i class="bi bi-arrow-left me-1"></i>Voltar ao Feed
</a>

<div class="row g-4">

    <div class="col-lg-8">

        <div class="card">
            @if (Model.Post.Imagem != null)
            {
                var base64 = Convert.ToBase64String(Model.Post.Imagem);
                <img src="data:image/png;base64,@base64"
                     class="card-img-top"
                     style="max-height:400px;object-fit:cover;border-radius:11px 11px 0 0;" />
            }

            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-success">@Model.Post.Topico</span>
                </div>

                <h2 class="fw-bold">@Model.Post.Titulo</h2>

                <div class="d-flex gap-3 text-dim small mb-3">
                    <span><i class="bi bi-person-fill me-1"></i>@Model.Post.Usuario.NomeCompleto</span>
                    <span><i class="bi bi-clock me-1"></i>@Model.Post.DataCriacao.ToString("dd/MM/yyyy HH:mm")</span>
                </div>

                <p class="fs-5" style="color:var(--text-muted);">@Model.Post.Descricao</p>

                @if (!string.IsNullOrEmpty(Model.Post.Detalhamento))
                {
                    <hr />
                    <h5 class="fw-bold"><i class="bi bi-info-circle me-2 text-primary"></i>Detalhamento</h5>
                    <div class="p-3 rounded" style="background:var(--bg-hover);">
                        @Html.Raw(Model.Post.Detalhamento.Replace("\n", "<br />"))
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Post.InformacaoEspecial))
                {
                    <hr />
                    <h5 class="fw-bold"><i class="bi bi-code-slash me-2 text-primary"></i>Informação Especial</h5>
                    <div class="p-3 rounded" style="background:var(--bg-hover);border:1px solid var(--twitch-purple);">
                        @Html.Raw(Model.Post.InformacaoEspecial.Replace("\n", "<br />"))
                    </div>
                }
            </div>

            @if (User.Identity?.IsAuthenticated == true && Model.Post.UsuarioId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
            {
                <div class="card-footer bg-transparent d-flex gap-2">
                    <a asp-controller="Post" asp-action="Edit" asp-route-id="@Model.Post.Id" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-pencil me-1"></i>Editar
                    </a>
                    <form asp-controller="Post" asp-action="Delete" asp-route-id="@Model.Post.Id" method="post"
                          onsubmit="return confirm('Excluir este post?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-trash me-1"></i>Excluir
                        </button>
                    </form>
                </div>
            }
        </div>

    </div>

    <div class="col-lg-4">

        @if (User.Identity?.IsAuthenticated == true && Model.Comentarios.Count < 6)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-pencil-square me-2 text-primary"></i>
                        Comentar
                    </h5>

                    <form asp-controller="Post" asp-action="Comentar" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="postId" value="@Model.Post.Id" />

                        <div class="mb-3">
                            <textarea asp-for="NovoComentario"
                                      class="form-control"
                                      rows="3"
                                      placeholder="O que você acha?"></textarea>
                            <span asp-validation-for="NovoComentario" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-send me-1"></i>Comentar
                        </button>
                    </form>
                </div>
            </div>
        }
        else if (!User.Identity?.IsAuthenticated == true)
        {
            <div class="card mb-4">
                <div class="card-body text-center py-3">
                    <p class="text-muted small mb-0">
                        <i class="bi bi-box-arrow-in-right me-1"></i>
                        Faça <a asp-controller="Account" asp-action="Login">login</a> para comentar.
                    </p>
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-chat-dots me-2 text-primary"></i>
                    Comentários
                </h5>
                <span class="badge bg-primary">@Model.Comentarios.Count/6</span>
            </div>

            <div class="card-body" style="max-height:600px;overflow-y:auto;">

                @if (Model.Comentarios.Any())
                {
                    @foreach (var comentario in Model.Comentarios)
                    {
                        <div class="comment-item">
                            @if (comentario.Usuario.FotoPerfil != null)
                            {
                                var fotoBase64 = Convert.ToBase64String(comentario.Usuario.FotoPerfil);
                                <img src="data:image;base64,@fotoBase64" class="comment-avatar" />
                            }
                            else
                            {
                                <div class="comment-avatar-placeholder">
                                    <i class="bi bi-person-fill text-dim small"></i>
                                </div>
                            }
                            <div class="comment-body">
                                <div class="d-flex justify-content-between align-items-center gap-2">
                                    <span class="comment-author">@comentario.Usuario.NomeCompleto</span>
                                    <span class="comment-time">@comentario.DataCriacao.ToString("dd/MM")</span>
                                </div>
                                <div class="comment-text">@comentario.Conteudo</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted small text-center py-3 mb-0">Nenhum comentário ainda.</p>
                }

                @if (Model.Comentarios.Count >= 6)
                {
                    <div class="alert alert-warning mt-2 mb-0 py-2 small">
                        <i class="bi bi-info-circle me-1"></i>
                        Limite máximo de 6 comentários atingido.
                    </div>
                }
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
