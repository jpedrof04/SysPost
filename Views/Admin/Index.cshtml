@using SysPost.Models
@{
    ViewData["Title"] = "Dashboard Admin";
    var usuarios = ViewBag.UsuariosComRoles as List<(Usuario Usuario, IList<string> Roles)>;
    var posts = ViewBag.TodosPosts as List<Post>;
    var ehSuperAdmin = ViewBag.EhSuperAdmin as bool? ?? false;
}

<div class="d-flex align-items-center gap-3 mb-4">
    <i class="bi bi-shield-fill-check text-primary" style="font-size:2rem;"></i>
    <h3 class="fw-bold mb-0">Administração</h3>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
            <div class="stat-number">@ViewBag.TotalUsuarios</div>
            <div class="stat-label">Total de Usuários</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon"><i class="bi bi-shield-fill-check"></i></div>
            <div class="stat-number">@ViewBag.TotalAdmins</div>
            <div class="stat-label">Administradores</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon"><i class="bi bi-person-fill"></i></div>
            <div class="stat-number">@ViewBag.TotalUsers</div>
            <div class="stat-label">Usuários Comuns</div>
        </div>
    </div>
</div>

<hr class="my-4" />

@* ═══════════ USUÁRIOS ═══════════ *@
<div class="d-flex align-items-center gap-3 mb-3">
    <i class="bi bi-people-fill text-primary" style="font-size:1.4rem;"></i>
    <h5 class="fw-bold mb-0">Usuários</h5>
    <span class="badge bg-primary">@(usuarios?.Count ?? 0)</span>
</div>

@if (usuarios != null && usuarios.Any())
{
    <div class="card p-0 mb-4">
        <div class="table-responsive">
            <table class="table table-dark table-borderless align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Usuário</th>
                        <th>E-mail</th>
                        <th>Perfil</th>
                        <th>Membro desde</th>
                        <th class="text-center pe-4">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in usuarios)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@item.Usuario.NomeCompleto</td>
                            <td class="text-muted">@item.Usuario.Email</td>
                            <td>
                                @if (item.Roles.Contains("Admin"))
                                {
                                    <span class="badge bg-primary">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Usuário</span>
                                }
                            </td>
                            <td class="text-muted small">@item.Usuario.DataCadastro.ToString("dd/MM/yyyy")</td>
                            <td class="text-center pe-4">
                                @if (item.Roles.Contains("Admin"))
                                {
                                    <form asp-action="RebaixarUser" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@item.Usuario.Id" />
                                        <button type="submit" class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-arrow-down me-1"></i>Rebaixar
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="PromoverAdmin" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@item.Usuario.Id" />
                                        <button type="submit" class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-arrow-up me-1"></i>Promover
                                        </button>
                                    </form>
                                }

                                @if (ehSuperAdmin)
                                {
                                    <form asp-action="ExcluirUsuario" method="post" class="d-inline ms-1"
                                          onsubmit="return confirm('Excluir permanentemente este usuário? Todas as postagens e comentários serão removidos.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@item.Usuario.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<hr class="my-4" />

@* ═══════════ POSTS ═══════════ *@
<div class="d-flex align-items-center gap-3 mb-3">
    <i class="bi bi-file-earmark-post text-primary" style="font-size:1.4rem;"></i>
    <h5 class="fw-bold mb-0">Posts</h5>
    <span class="badge bg-primary">@(posts?.Count ?? 0)</span>
</div>

@if (posts != null && posts.Any())
{
    <div class="posts-grid">
        @foreach (var post in posts)
        {
            <div class="post-card">
                <div class="post-card-header">
                    <div class="post-author">
                        <div class="author-avatar">
                            @if (post.Usuario.FotoPerfil != null)
                            {
                                <img src="data:image/png;base64,@Convert.ToBase64String(post.Usuario.FotoPerfil)" />
                            }
                            else
                            {
                                <i class="bi bi-person-fill"></i>
                            }
                        </div>
                        <div class="author-info">
                            <span class="author-name">@post.Usuario.NomeCompleto</span>
                            <span class="post-date">@post.DataCriacao.ToString("dd MMM yyyy")</span>
                        </div>
                    </div>
                    <div class="post-card-header-right">
                        <a asp-controller="Home" asp-action="Index" asp-route-topico="@((int)post.Topico)">
                            <span class="topic-badge">@post.Topico</span>
                        </a>
                        <a asp-controller="Post" asp-action="Detalhes" asp-route-id="@post.Id" class="ver-mais-link">ver +</a>
                    </div>
                </div>

                <div class="post-card-body">
                    <a asp-controller="Post" asp-action="Detalhes" asp-route-id="@post.Id" class="post-card-title">
                        @post.Titulo
                    </a>
                    <p class="post-card-desc">@post.Descricao</p>

                    @if (!string.IsNullOrEmpty(post.Detalhamento))
                    {
                        <div class="card-info-section">@post.Detalhamento</div>
                    }

                    @if (!string.IsNullOrEmpty(post.InformacaoEspecial))
                    {
                        <div class="card-info-section info-special">
                            <i class="bi bi-code-slash me-1"></i>
                            @post.InformacaoEspecial
                        </div>
                    }
                </div>

                @if (post.Imagem != null)
                {
                    var base64 = Convert.ToBase64String(post.Imagem);
                    <div class="post-card-img">
                        <img src="data:image/png;base64,@base64" />
                    </div>
                }

                <div class="post-card-footer">
                    <button type="button" class="post-action" onclick="openComments(@post.Id)">
                        <i class="bi bi-chat-dots"></i>
                        <span>@post.Comentarios.Count</span>
                    </button>

                    <form asp-action="ExcluirPost" method="post" class="d-inline"
                          onsubmit="return confirm('Excluir este post?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@post.Id" />
                        <button type="submit" class="post-action text-danger">
                            <i class="bi bi-trash"></i>
                            <span>Excluir</span>
                        </button>
                    </form>
                </div>
            </div>

            @* ─── MODAL DE COMENTÁRIOS ─── *@
            <div id="comments-modal-@post.Id" class="comment-modal-overlay">
                <div class="comment-modal-card">
                    <div class="comment-modal-header">
                        <h5><i class="bi bi-chat-dots text-primary me-2"></i>Comentários (@post.Comentarios.Count/6)</h5>
                        <button type="button" class="comment-modal-close" onclick="closeComments(@post.Id)">&times;</button>
                    </div>
                    <div class="px-3 pt-2 pb-1 d-flex align-items-center justify-content-between border-bottom" style="border-color:var(--border-subtle);">
                        <span class="badge bg-success" style="font-size:0.65rem;">@post.Topico</span>
                        <a asp-controller="Post" asp-action="Detalhes" asp-route-id="@post.Id" class="small" style="color:var(--text-dim);text-decoration:none;">
                            ver +
                        </a>
                    </div>

                    <div class="comment-modal-body-wrapper">
                        <div class="comment-modal-body">
                            @if (post.Comentarios.Any())
                            {
                                @foreach (var c in post.Comentarios.OrderByDescending(x => x.DataCriacao).Take(6))
                                {
                                    <div class="comment-item">
                                        @if (c.Usuario.FotoPerfil != null)
                                        {
                                            var fotoBase64 = Convert.ToBase64String(c.Usuario.FotoPerfil);
                                            <img src="data:image;base64,@fotoBase64" class="comment-avatar" />
                                        }
                                        else
                                        {
                                            <div class="comment-avatar-placeholder">
                                                <i class="bi bi-person-fill text-dim small"></i>
                                            </div>
                                        }
                                        <div class="comment-body">
                                            <div class="d-flex justify-content-between align-items-center gap-2">
                                                <span class="comment-author">@c.Usuario.NomeCompleto</span>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="comment-time">@c.DataCriacao.ToString("dd/MM")</span>
                                                    <form asp-action="ExcluirComentario" method="post" class="d-inline"
                                                          onsubmit="return confirm('Excluir comentário?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@c.Id" />
                                                        <input type="hidden" name="postId" value="@post.Id" />
                                                        <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" style="font-size:0.65rem;line-height:1.2;">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                            <div class="comment-text">@c.Conteudo</div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted small text-center py-3 mb-0">Nenhum comentário ainda.</p>
                            }

                            @if (post.Comentarios.Count >= 6)
                            {
                                <div class="alert alert-warning mt-2 mb-0 py-2 small">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Limite máximo de 6 comentários atingido.
                                </div>
                            }
                        </div>

                        @if (post.Imagem != null)
                        {
                            var imgBase64 = Convert.ToBase64String(post.Imagem);
                            <div class="comment-modal-image-panel">
                                <div class="floating-image">
                                    <img src="data:image/png;base64,@imgBase64" />
                                </div>
                            </div>
                        }
                    </div>

                    @if (User.Identity?.IsAuthenticated == true && post.Comentarios.Count < 6)
                    {
                        <div class="comment-modal-form">
                            <form asp-controller="Post" asp-action="Comentar" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="postId" value="@post.Id" />
                                <div class="mb-2">
                                    <textarea name="NovoComentario" rows="2" placeholder="O que você acha?" maxlength="500"></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary btn-sm w-100">
                                    <i class="bi bi-send me-1"></i>Comentar
                                </button>
                            </form>
                        </div>
                    }
                    else if (!User.Identity?.IsAuthenticated == true)
                    {
                        <div class="comment-modal-form text-center py-2">
                            <p class="text-muted small mb-0">
                                <i class="bi bi-box-arrow-in-right me-1"></i>
                                Faça <a asp-controller="Account" asp-action="Login">login</a> para comentar.
                            </p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-4">
        <i class="bi bi-inbox text-dim" style="font-size:2rem;"></i>
        <p class="text-muted mt-2 small">Nenhum post encontrado.</p>
    </div>
}
