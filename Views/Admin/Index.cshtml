@{
    ViewData["Title"] = "Dashboard Admin";
}

<div class="admin-page">
    <div class="container py-4">
        <div class="d-flex align-items-center gap-3 mb-4">
            <i class="bi bi-speedometer2 fs-1 text-primary"></i>
            <h2 class="fw-bold mb-0">Dashboard Administrativo</h2>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card text-center p-4">
                    <i class="bi bi-people fs-1 text-primary mb-2"></i>
                    <h3 class="fw-bold text-primary mb-0">@ViewBag.TotalUsuarios</h3>
                    <p class="text-muted mb-0">Total de Usuários</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center p-4">
                    <i class="bi bi-shield-lock fs-1 text-primary mb-2"></i>
                    <h3 class="fw-bold text-primary mb-0">@ViewBag.TotalAdmins</h3>
                    <p class="text-muted mb-0">Administradores</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center p-4">
                    <i class="bi bi-person fs-1 text-primary mb-2"></i>
                    <h3 class="fw-bold text-primary mb-0">@ViewBag.TotalUsers</h3>
                    <p class="text-muted mb-0">Usuários Comuns</p>
                </div>
            </div>
        </div>

        <div class="mt-4 text-center">
            <a asp-action="Usuarios" class="btn btn-primary btn-lg px-5">
                <i class="bi bi-person-gear me-2"></i>Gerenciar Usuários
            </a>
        </div>
        <div>
            <a asp-controller="Admin" asp-action="Posts" class="btn btn-outline-light btn-lg mt-3">
                <i class="bi bi-file-post me-2"></i>
                Gerenciar Posts
            </a>
        </div>
    </div>
</div>
