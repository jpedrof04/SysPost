@model SysPost.Models.Post
@{
    ViewData["Title"] = "Detalhes do Post";
}

<div class="admin-page">

    <a asp-action="Posts" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="bi bi-arrow-left me-1"></i>Voltar para Posts
    </a>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <span class="badge bg-success mb-2 fs-6">@Model.Topico</span>
            <h3 class="fw-bold">@Model.Titulo</h3>

            <div class="d-flex gap-3 text-muted small mb-3">
                <span><i class="bi bi-person me-1"></i>@Model.Usuario.NomeCompleto</span>
                <span><i class="bi bi-clock me-1"></i>@Model.DataCriacao.ToString("dd/MM/yyyy HH:mm")</span>
            </div>

            <p class="card-text">@Model.Descricao</p>

            @if (!string.IsNullOrEmpty(Model.Detalhamento))
            {
                <hr />
                <h5 class="fw-bold"><i class="bi bi-info-circle me-2"></i>Detalhamento</h5>
                <div class="bg-dark p-3 rounded">
                    @Html.Raw(Model.Detalhamento.Replace("\n", "<br />"))
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.InformacaoEspecial))
            {
                <hr />
                <h5 class="fw-bold"><i class="bi bi-code-slash me-2"></i>Informação Especial</h5>
                <div class="bg-dark p-3 rounded border border-primary">
                    @Html.Raw(Model.InformacaoEspecial.Replace("\n", "<br />"))
                </div>
            }
        </div>
    </div>

    @* ─── COMENTÁRIOS ─── *@
    <div class="card shadow-sm border-0">
        <div class="card-header bg-transparent border-bottom">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-chat-dots me-2 text-primary"></i>
                Comentários (@Model.Comentarios.Count/6)
            </h5>
        </div>

        <div class="card-body">
            @if (Model.Comentarios.Any())
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Usuário</th>
                                <th>Comentário</th>
                                <th>Data</th>
                                <th width="100">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var comentario in Model.Comentarios.OrderByDescending(c => c.DataCriacao))
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (comentario.Usuario.FotoPerfil != null)
                                            {
                                                var fotoBase64 = Convert.ToBase64String(comentario.Usuario.FotoPerfil);
                                                <img src="data:image;base64,@fotoBase64"
                                                     class="rounded-circle"
                                                     style="width:32px;height:32px;object-fit:cover;" />
                                            }
                                            else
                                            {
                                                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center"
                                                     style="width:32px;height:32px;">
                                                    <i class="bi bi-person text-white small"></i>
                                                </div>
                                            }
                                            <strong>@comentario.Usuario.NomeCompleto</strong>
                                        </div>
                                    </td>
                                    <td>@comentario.Conteudo</td>
                                    <td>@comentario.DataCriacao.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <form asp-action="ExcluirComentario"
                                              method="post"
                                              onsubmit="return confirm('Excluir este comentário?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@comentario.Id" />
                                            <input type="hidden" name="postId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-danger btn-sm">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">Nenhum comentário neste post.</p>
            }
        </div>
    </div>

</div>
