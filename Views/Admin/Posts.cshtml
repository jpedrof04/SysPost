@model List<SysPost.Models.Post>

@{
    ViewData["Title"] = "Todos os Posts";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <i class="bi bi-file-earmark-post text-primary" style="font-size:1.8rem;"></i>
    <h4 class="fw-bold mb-0">Todos os Posts</h4>
    <span class="badge bg-primary">@Model.Count total</span>
</div>

<div class="table-responsive">
    <table class="table table-dark table-hover align-middle">
        <thead>
            <tr>
                <th>Título</th>
                <th>Usuário</th>
                <th>Tópico</th>
                <th>Data</th>
                <th class="text-center">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var post in Model)
            {
                <tr>
                    <td>
                        <a asp-action="DetalhesPost" asp-route-id="@post.Id" class="fw-bold" style="color:var(--text-primary);">
                            @post.Titulo
                            <i class="bi bi-box-arrow-up-right ms-1 small text-primary"></i>
                        </a>
                    </td>
                    <td class="text-muted">@post.Usuario.NomeCompleto</td>
                    <td><span class="badge bg-success">@post.Topico</span></td>
                    <td class="text-muted small">@post.DataCriacao.ToString("dd/MM/yyyy")</td>
                    <td class="text-center">
                        <div class="d-flex gap-1 justify-content-center">
                            <a asp-action="DetalhesPost" asp-route-id="@post.Id" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-eye"></i>
                            </a>
                            <form asp-action="ExcluirPost" method="post"
                                  onsubmit="return confirm('Excluir este post?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@post.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
