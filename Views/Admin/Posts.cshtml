@model List<SysPost.Models.Post>

@{
    ViewData["Title"] = "Todos os Posts";
}

<h2 class="fw-bold mb-4">
    <i class="bi bi-file-earmark-post me-2 text-primary"></i>
    Todos os Posts
</h2>

<div class="table-responsive">

    <table class="table table-dark table-hover align-middle">

        <thead>
            <tr>
                <th>Título</th>
                <th>Usuário</th>
                <th>Tópico</th>
                <th>Data</th>
                <th width="120">Ações</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var post in Model)
            {
                <tr>

                    <td>
                        <a asp-action="DetalhesPost" asp-route-id="@post.Id" class="fw-bold text-white">
                            @post.Titulo
                            <i class="bi bi-box-arrow-up-right ms-1 small text-primary"></i>
                        </a>
                    </td>

                    <td>
                        @post.Usuario.NomeCompleto
                    </td>

                    <td>
                        <span class="badge bg-success">
                            @post.Topico
                        </span>
                    </td>

                    <td>
                        @post.DataCriacao.ToString("dd/MM/yyyy")
                    </td>

                    <td>
                        <div class="d-flex gap-1">
                            <a asp-action="DetalhesPost" asp-route-id="@post.Id" class="btn btn-outline-info btn-sm">
                                <i class="bi bi-eye"></i>
                            </a>

                            <form asp-action="ExcluirPost"
                                  method="post"
                                  onsubmit="return confirm('Tem certeza que deseja excluir este post?');">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@post.Id" />

                                <button class="btn btn-danger btn-sm">
                                    <i class="bi bi-trash"></i>
                                </button>

                            </form>
                        </div>
                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>